# ====================================================================
# 📋 EXAMPLE ENVIRONMENT VARIABLES (SAFE FOR PUBLIC GIT)
# Copy this file to .env and fill in your real values.
# ====================================================================

PORT=4000
NODE_ENV=development

# 🗄️ SQLite Database Path (Stored outside Git in ./data/pocket.db)
DB_PATH=./data/pocket.db
# 🔐 JWT Secret for Web Dashboard Login 
JWT_SECRET=replace_with_your_super_secret_jwt_key_at_least_32_chars

# 🤖 Telegram Bot Configuration (Get from @BotFather on Telegram)
TELEGRAM_BOT_TOKEN=replace_with_your_telegram_bot_token
# 🛡️ Security Whitelist: Only this Telegram User ID can use the bot!
# (Leave empty during first test to let the bot tell you your Chat ID, then lock it!)
ALLOWED_TELEGRAM_IDS=
# database cloud
TURSO_DATABASE_URL=libsql://your-db-name.turso.io
TURSO_AUTH_TOKEN=your_turso_auth_token_here
